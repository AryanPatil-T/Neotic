# Gemini AI API (server-side; automatically injected in AI Studio or set locally)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Free Text AI Providers (for automatic multi-provider failover)
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""

# Optional Stock Photo Provider (falls back to 0-key Openverse & Wikimedia Commons)
PEXELS_API_KEY=""

# Optional Webhook Secret for external 08:00 AM cron triggers (POST /api/automation/cron-trigger)
AUTOMATION_WEBHOOK_SECRET=""

# Optional Cloud Hosting Persistence & Performance (helpful on Render Free)
GOOGLE_SHEET_URL=""
AUTOMATION_TIMEZONE="Asia/Kolkata"
LOW_MEMORY="true"

# Optional 24/7 Unattended Server Upload Credentials (for headless Render 08:00 AM auto-uploads)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""

# App URL
APP_URL="http://localhost:3000"
